[gd_scene format=3 uid="uid://86yvyb2aghnx"]

[sub_resource type="GDScript" id="GDScript_5ye3o"]
script/source = "
extends Control

# Nạp hai module quản lý
const SaveManagerScript = preload(\"res://scripts/data/save_manager.gd\")
const AudioManagerScript = preload(\"res://scripts/data/audio_manager.gd\")

# Âm thanh giao diện
const CLICK_SOUND: AudioStream = preload(
    \"res://assets/audio/click_sound.mp3\"
)

# Các node giao diện hiện có
@onready var save_level_2_button: Button = $MarginContainer/Content/SaveLevel2Button
@onready var load_progress_button: Button = $MarginContainer/Content/LoadProgressButton
@onready var sound_off_button: Button = $MarginContainer/Content/SoundOffButton
@onready var sound_on_button: Button = $MarginContainer/Content/SoundOnButton
@onready var reset_button: Button = $MarginContainer/Content/ResetProgressButton
@onready var status_label: Label = $MarginContainer/Content/StatusLabel

# Khởi tạo các modules
var save_manager = SaveManagerScript.new()
var audio_manager


# ---------------- Khởi tạo ----------------

func _ready() -> void:
	# Tạo AudioManager
	audio_manager = AudioManagerScript.new()
	add_child(audio_manager)

	# Kết nối các nút
	save_level_2_button.pressed.connect(_on_save_level_2)
	load_progress_button.pressed.connect(_on_load_progress)
	sound_off_button.pressed.connect(_on_sound_off)
	sound_on_button.pressed.connect(_on_sound_on)
	reset_button.pressed.connect(_on_reset)

	# Đọc dữ liệu đã lưu
	var data: Dictionary = save_manager.load_progress()

	# Khôi phục trạng thái âm thanh
	audio_manager.set_sound_enabled(data[\"sound_enabled\"])

	# Cập nhật giao diện, không phát tiếng khi khởi động
	_update_status(data)


# ---------------- Lưu tiến trình ----------------

func _on_save_level_2() -> void:
	var data: Dictionary = save_manager.load_progress()

	# Lưu tiến trình Level 2
	data[\"unlocked_level\"] = 2

	if save_manager.save_progress(data):
		status_label.text = \"Đã lưu Level 2!\"
		audio_manager.play_sound(CLICK_SOUND)
	else:
		status_label.text = \"Lưu thất bại!\"


# ---------------- Đọc tiến trình ----------------

func _on_load_progress() -> void:
	var data: Dictionary = save_manager.load_progress()

	# Khôi phục trạng thái âm thanh
	audio_manager.set_sound_enabled(data[\"sound_enabled\"])

	# Hiển thị dữ liệu
	_update_status(data)

	# Phát tiếng khi người dùng nhấn Load
	audio_manager.play_sound(CLICK_SOUND)


# ---------------- Bật / Tắt âm thanh ----------------

func _on_sound_off() -> void:
	var data: Dictionary = save_manager.load_progress()

	data[\"sound_enabled\"] = false

	if save_manager.save_progress(data):
		audio_manager.set_sound_enabled(false)
		status_label.text = \"Sound: OFF\"
	else:
		status_label.text = \"Không thể lưu trạng thái âm thanh!\"


func _on_sound_on() -> void:
	var data: Dictionary = save_manager.load_progress()

	data[\"sound_enabled\"] = true

	if save_manager.save_progress(data):
		audio_manager.set_sound_enabled(true)
		status_label.text = \"Sound: ON\"
		audio_manager.play_sound(CLICK_SOUND)
	else:
		status_label.text = \"Không thể lưu trạng thái âm thanh!\"


# ---------------- Đặt lại tiến trình ----------------

func _on_reset() -> void:
	var default_data = {
		\"unlocked_level\": 1,
		\"sound_enabled\": true
	}

	if save_manager.save_progress(default_data):
		audio_manager.set_sound_enabled(true)
		status_label.text = \"Đã đặt lại tiến trình!\"
	else:
		status_label.text = \"Reset thất bại!\"


# ---------------- Cập nhật giao diện ----------------

func _update_status(data: Dictionary) -> void:
	status_label.text = \"Level: %d | Sound: %s\" % [
		data[\"unlocked_level\"],
		data[\"sound_enabled\"]
	]
"


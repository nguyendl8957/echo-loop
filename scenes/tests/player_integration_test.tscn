[sub_resource type="GDScript" id="GDScript_ms424"]
script/source = "extends Node2D

@onready var player: PlayerController = $Player
@onready var status_label: Label = $Label

var passed: int = 0
var failed: int = 0


func _ready() -> void:
	status_label.position = Vector2(16, 160)

	# Bản đồ thử có các ô x, y từ 0 đến 2.
	# Caller truyền tường (2, 1) và ô ngoài biên (-1, 1).
	var blocked_cells: Array[Vector2i] = [
		Vector2i(2, 1),
		Vector2i(-1, 1),
	]

	_check_reset(Vector2i(1, 1), Vector2(72, 72))
	_check_action(\"RIGHT\", blocked_cells, false, Vector2i(1, 1), Vector2(72, 72), \"Wall\")
	_check_action(\"UP\", blocked_cells, true, Vector2i(1, 0), Vector2(72, 24))
	_check_action(\"RIGHT\", blocked_cells, true, Vector2i(2, 0), Vector2(120, 24))
	_check_action(\"LEFT\", blocked_cells, true, Vector2i(1, 0), Vector2(72, 24))
	_check_action(\"DOWN\", blocked_cells, true, Vector2i(1, 1), Vector2(72, 72))
	_check_action(\"WAIT\", blocked_cells, false, Vector2i(1, 1), Vector2(72, 72))
	_check_action(\"JUMP\", blocked_cells, false, Vector2i(1, 1), Vector2(72, 72), \"Invalid\")
	_check_action(\"LEFT\", blocked_cells, true, Vector2i(0, 1), Vector2(24, 72))
	_check_action(\"LEFT\", blocked_cells, false, Vector2i(0, 1), Vector2(24, 72), \"Bounds\")

	_check_reset(Vector2i(1, 2), Vector2(72, 120))
	for cycle in range(1, 11):
		_check_action(\"RIGHT\", blocked_cells, true, Vector2i(2, 2), Vector2(120, 120), \"Cycle %d\" % cycle)
		_check_action(\"LEFT\", blocked_cells, true, Vector2i(1, 2), Vector2(72, 120), \"Cycle %d\" % cycle)

	status_label.text = \"Player Integration Test\\nPASS: %d | FAIL: %d\" % [passed, failed]
	print(status_label.text)


func _check_reset(expected_cell: Vector2i, expected_pixel: Vector2) -> void:
	player.reset_position(expected_cell)
	var ok := player.grid_position == expected_cell and player.position == expected_pixel
	_report(ok, \"RESET expected %s / %s, got %s / %s\" % [
		expected_cell, expected_pixel, player.grid_position, player.position
	])


func _check_action(
	action: String,
	blocked_cells: Array[Vector2i],
	expected_moved: bool,
	expected_cell: Vector2i,
	expected_pixel: Vector2,
	context: String = \"\"
) -> void:
	var moved := player.apply_action(action, blocked_cells)
	var ok := (
		moved == expected_moved
		and player.grid_position == expected_cell
		and player.position == expected_pixel
	)
	_report(ok, \"%s %s expected %s / %s / %s, got %s / %s / %s\" % [
		context, action, expected_moved, expected_cell, expected_pixel,
		moved, player.grid_position, player.position
	])


func _report(ok: bool, detail: String) -> void:
	if ok:
		passed += 1
		print(\"PASS | \", detail)
	else:
		failed += 1
		push_error(\"FAIL | \" + detail)
"

